[0.0,"o","\u001b[38;5;117m[STAGING : arbiter]\u001b[0m wrote conf/arbiter/account/smtp/bot.yaml\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m wrote conf/arbiter/policy/smtp/bot_policy.yaml\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m \r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m Edit the generated account and policy files.\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m \r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m Rebuild the env file after edits:\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m   reploy app env bootstrap\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m \r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m Review activation status:\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m   reploy app activate\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m \r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m Activate the accounts when ready:\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m   reploy app activate --plugins imap,smtp --account bot\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m \r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m Then inspect the composed config with:\r\n\u001b[38;5;117m[STAGING : arbiter]\u001b[0m   reploy app config show\r\n"]
